model Class {
  id                            String                      @id
  name                          String
  courseId                       String                      @map("course_id")
  status                        ClassStatus                 @default(running)
  maxStudents                   Int                         @default(15) @map("max_students")
  allowancePerSessionPerStudent Int                         @default(0) @map("allowance_per_session_per_student")
  maxAllowancePerSession        Int?                        @map("max_allowance_per_session")
  scaleAmount                   Int?                        @map("scale_amount")
  /// @deprecated Nguồn dữ liệu cũ, giữ lại làm backup lịch sử tại thời điểm migrate sang `ClassScheduleEntry`. Không ghi tiếp.
  schedule                      Json                        @default("[]")
  studentTuitionPerSession      Int?                        @map("student_tuition_per_session")
  tuitionPackageTotal           Int?                        @map("tuition_package_total")
  tuitionPackageSession         Int?                        @map("tuition_package_session")
  noAttendance                  Boolean                     @default(false) @map("no_attendance")
  /// Ngày hết hạn xem nội dung của lớp (tính theo lớp, không theo từng HS).
  /// Null = vô hạn. Được chốt lúc tạo lớp từ Course.defaultDurationDays,
  /// sau đó admin có thể sửa tay. Sửa Course.defaultDurationDays KHÔNG hồi tố.
  contentAccessExpiresAt        DateTime?                   @map("content_access_expires_at") @db.Date
  trainingManagerStaffId        String?                     @map("training_manager_staff_id")
  trainingManagerRatePercent    Decimal?                    @map("training_manager_rate_percent") @db.Decimal(5, 2)
  createdAt                     DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  surveys                       ClassSurvey[]
  surveyExclusions              SurveyExcludedClass[]
  teachers                      ClassTeacher[]
  makeupScheduleEvents          MakeupScheduleEvent[]
  missedTeachingExplanations    MissedTeachingExplanation[]
  scheduleEntries               ClassScheduleEntry[]
  sessions                      Session[]
  students                      StudentClass[]
  topics                        Topic[]
  trainingManager               StaffInfo?                  @relation("ClassTrainingManager", fields: [trainingManagerStaffId], references: [id])
  course                        Course                      @relation(fields: [courseId], references: [id])

  @@index([trainingManagerStaffId])
  @@index([courseId])
  @@index([contentAccessExpiresAt])
  @@map("classes")
}

/// Khoá học — chương trình học độc lập có nội dung học thuật riêng, ngân hàng câu hỏi riêng và thời hạn mặc định.
model Course {
  id                  String                @id @default(uuid())
  name                String
  defaultDurationDays Int?                  @map("default_duration_days")
  sortOrder           Int                   @default(0) @map("sort_order")
  isActive            Boolean               @default(true) @map("is_active")
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  classes             Class[]
  chapters            Chapter[]
  topics              Topic[]
  difficultyLevels    CourseDifficultyLevel[]
  lessonPlanMembers   CourseLessonPlanMember[]
  questions           Question[]           // <‑‑ back‑relation for question bank

  @@map("courses")
}

/// Thang độ khó riêng của mỗi Khoá học.
model CourseDifficultyLevel {
  id        String   @id @default(uuid())
  courseId   String   @map("course_id")
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions Question[] // back‑relation for question bank

  @@unique([courseId, name])
  @@index([courseId])
  @@map("course_difficulty_levels")
}

/// Đội giáo án được gán vào một Khoá học để soạn nội dung học thuật và ngân hàng
/// câu hỏi của khoá đó. Việc gán do admin, Trưởng giáo án (`lesson_plan_head`) hoặc
/// Trợ lí (`assistant`) thực hiện. Thành viên `lesson_plan` chỉ thấy khoá mình được gán;
/// `lesson_plan_head` thấy và sửa được nội dung của mọi khoá.
model CourseLessonPlanMember {
  id        String   @id @default(uuid())
  courseId   String   @map("course_id")
  staffId   String   @map("staff_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  staff     StaffInfo @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([courseId, staffId])
  @@index([courseId])
  @@index([staffId])
  @@map("course_lesson_plan_members")
}

/// Chủ đề — nhóm nội dung cấp cao nhất bên trong một Khoá học.
model Chapter {
  id        String   @id @default(uuid())
  courseId   String   @map("course_id")
  title     String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topics    Topic[]
  questions Question[] // back‑relation for question bank

  @@index([courseId])
  @@map("chapters")
}

model ClassTeacher {
  id                            String    @id @default(uuid())
  classId                       String    @map("class_id")
  teacherId                     String    @map("teacher_id")
  customAllowance               Int?      @map("custom_allowance")
  operatingDeductionRatePercent Decimal   @default(0) @map("tax_rate_percent") @db.Decimal(5, 2)
  status                        String?
  createdAt                     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  class                         Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher                       StaffInfo @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([classId, teacherId])
  @@index([classId])
  @@index([teacherId])
  @@map("class_teachers")
}

/// Lịch cố định của lớp (thay thế `Class.schedule` JSON). Mỗi dòng là 1 slot cố định
/// (thứ + giờ) có hiệu lực trong khoảng [effectiveFrom, effectiveTo). `effectiveTo = null`
/// nghĩa là slot đang active. Khi admin đổi giáo viên/giờ cho 1 slot, slot cũ được
/// "đóng" bằng cách set `effectiveTo`, slot mới được insert với `effectiveFrom` tương ứng —
/// không update đè để giữ lịch sử chính xác cho thuật toán cảnh báo "chưa dạy".
model ClassScheduleEntry {
  id                    String     @id @default(uuid())
  classId               String     @map("class_id")
  teacherId             String?    @map("teacher_id")
  dayOfWeek             Int        @map("day_of_week")
  from                  String
  to                    String
  meetLink              String?    @map("meet_link")
  googleCalendarEventId String?    @map("google_calendar_event_id")
  effectiveFrom         DateTime   @map("effective_from") @db.Date
  effectiveTo           DateTime?  @map("effective_to") @db.Date
  createdByStaffId      String?    @map("created_by_staff_id")
  createdAt             DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  class                 Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher               StaffInfo? @relation(fields: [teacherId], references: [id])

  @@index([classId])
  @@index([teacherId])
  @@index([classId, effectiveTo])
  @@index([classId, dayOfWeek, effectiveTo])
  @@map("class_schedule_entries")
}

model StudentClass {
  id                             String              @id @default(uuid())
  studentId                      String              @map("student_id")
  classId                        String              @map("class_id")
  status                         StudentClassStatus?
  customStudentTuitionPerSession Int?                @map("custom_student_tuition_per_session")
  customTuitionPackageTotal      Int?                @map("custom_tuition_package_total")
  customTuitionPackageSession    Int?                @map("custom_tuition_package_session")
  totalAttendedSession           Int?                @map("total_attended_session")
  createdAt                      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  class                          Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  student                        StudentInfo         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([classId])
  @@index([classId, studentId])
  @@index([classId, status, createdAt])
  @@index([studentId, classId])
  @@map("student_classes")
}

model Session {
  id                                     String               @id @default(uuid())
  teacherId                              String               @map("teacher_id")
  classId                                String               @map("class_id")
  allowanceAmount                        Int?                 @map("allowance_amount")
  snapshotPerStudentAllowance            Int?                 @map("snapshot_per_student_allowance")
  snapshotScaleAmount                    Int?                 @map("snapshot_scale_amount")
  teacherOperatingDeductionRatePercent   Decimal              @default(0) @map("teacher_tax_rate_percent") @db.Decimal(5, 2)
  teacherTaxDeductionRatePercent         Decimal              @default(0) @map("teacher_tax_deduction_rate_percent") @db.Decimal(5, 2)
  teacherPaymentStatus                   String               @default("unpaid") @map("teacher_payment_status")
  trainingManagerStaffId                 String?              @map("training_manager_staff_id")
  trainingManagerRatePercent             Decimal              @default(0) @map("training_manager_rate_percent") @db.Decimal(5, 2)
  trainingManagerAllowanceAmount         Int?                 @map("training_manager_allowance_amount")
  trainingManagerPaymentStatus           PaymentStatus?       @map("training_manager_payment_status")
  trainingManagerTaxDeductionRatePercent Decimal              @default(0) @map("training_manager_tax_deduction_rate_percent") @db.Decimal(5, 2)
  date                                   DateTime             @db.Date
  startTime                              DateTime?            @map("start_time") @db.Time(6)
  endTime                                DateTime?            @map("end_time") @db.Time(6)
  snapshotNoAttendance                   Boolean              @default(false) @map("snapshot_no_attendance")
  coefficient                            Decimal              @default(1.0) @db.Decimal(3, 1)
  notes                                  String?
  lessonContent                          String?              @map("lesson_content")
  homework                               String?
   tutorial                               String?
   recordingUrl                           String?              @map("recording_url")
   tuitionFee                             Int?                 @map("tuition_fee")
  googleMeetLink                         String?              @map("google_meet_link")
  googleCalendarEventId                  String?              @map("google_calendar_event_id")
  calendarSyncedAt                       DateTime?            @map("calendar_synced_at") @db.Timestamptz(6)
  calendarSyncError                      String?              @map("calendar_sync_error")
  createdAt                              DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                              DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  attendance                             Attendance[]
  class                                  Class                @relation(fields: [classId], references: [id], onDelete: Cascade)
  makeupScheduleEvent                    MakeupScheduleEvent?
  teacher                                StaffInfo            @relation("SessionTeacher", fields: [teacherId], references: [id])
  trainingManager                        StaffInfo?           @relation("SessionTrainingManager", fields: [trainingManagerStaffId], references: [id])

  @@index([teacherId])
  @@index([classId])
  @@index([trainingManagerStaffId, trainingManagerPaymentStatus])
  @@index([date])
  @@index([classId, date])
  @@index([classId, teacherId, date])
  @@index([teacherPaymentStatus, date, teacherId])
  @@index([teacherId, date])
  @@index([teacherId, teacherPaymentStatus, date])
  @@index([googleCalendarEventId])
  @@map("sessions")
}

model MakeupScheduleEvent {
  id                      String    @id @default(uuid()) @db.Text
  classId                 String    @map("class_id") @db.Text
  teacherId               String    @map("teacher_id") @db.Text
  linkedSessionId         String?   @unique @map("linked_session_id") @db.Text
  date                    DateTime  @db.Date
  startTime               DateTime? @map("start_time") @db.Time(6)
  endTime                 DateTime? @map("end_time") @db.Time(6)
  baselineScheduleEntryId String?   @map("baseline_schedule_entry_id") @db.Text
  originalDate            DateTime? @map("original_date") @db.Date
  title                   String?
  note                    String?
  googleMeetLink          String?   @map("google_meet_link")
  googleCalendarEventId   String?   @map("google_calendar_event_id")
  calendarSyncedAt        DateTime? @map("calendar_synced_at") @db.Timestamptz(6)
  calendarSyncError       String?   @map("calendar_sync_error")
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  class                   Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  linkedSession           Session?  @relation(fields: [linkedSessionId], references: [id], onDelete: SetNull)
  teacher                 StaffInfo @relation(fields: [teacherId], references: [id])

  @@index([classId])
  @@index([teacherId])
  @@index([date])
  @@index([classId, date])
  @@index([baselineScheduleEntryId])
  @@index([classId, baselineScheduleEntryId, originalDate])
  @@index([teacherId, date])
  @@index([googleCalendarEventId])
  @@map("makeup_schedule_events")
}

model MissedTeachingExplanation {
  id                      String    @id @default(uuid()) @db.Text
  classId                 String    @map("class_id") @db.Text
  teacherId               String    @map("teacher_id") @db.Text
  baselineScheduleEntryId String    @map("baseline_schedule_entry_id") @db.Text
  originalDate            DateTime  @map("original_date") @db.Date
  reason                  String
  explainedByStaffId      String?   @map("explained_by_staff_id") @db.Text
  explainedByUserId       String?   @map("explained_by_user_id") @db.Text
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  class                   Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher                 StaffInfo @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  @@unique([classId, baselineScheduleEntryId, originalDate])
  @@index([classId])
  @@index([teacherId])
  @@index([classId, teacherId, originalDate])
  @@map("missed_teaching_explanations")
}

model Attendance {
  id                                  String                     @id @default(uuid())
  sessionId                           String                     @map("session_id")
  studentId                           String                     @map("student_id")
  status                              AttendanceStatus           @default(present)
  notes                               String?
  createdAt                           DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  customerCareCoef                    Decimal?                   @map("customer_care_coef") @db.Decimal(3, 2)
  customerCareStaffId                 String?                    @map("customer_care_staff_id")
  customerCarePaymentStatus           PaymentStatus?             @map("customer_care_payment_status")
  customerCareTaxDeductionRatePercent Decimal                    @default(0) @map("customer_care_tax_deduction_rate_percent") @db.Decimal(5, 2)
  tuitionFee                          Int?                       @map("tuition_fee")
  transactionId                       String?                    @unique @map("transaction_id")
  assistantManagerStaffId             String?                    @map("assistant_manager_staff_id")
  assistantPaymentStatus              PaymentStatus?             @map("assistant_payment_status")
  assistantTaxDeductionRatePercent    Decimal                    @default(0) @map("assistant_tax_deduction_rate_percent") @db.Decimal(5, 2)
  assistantManagerStaff               StaffInfo?                 @relation("AttendanceAssistant", fields: [assistantManagerStaffId], references: [id])
  customerCareStaff                   StaffInfo?                 @relation("AttendanceCustomerCare", fields: [customerCareStaffId], references: [id])
  session                             Session                    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student                             StudentInfo                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  transaction                         WalletTransactionsHistory? @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  lessonPlanHeadCommissions           LessonPlanHeadCommission[]

  @@unique([sessionId, studentId])
  @@index([sessionId])
  @@index([studentId])
  @@index([customerCareStaffId, customerCarePaymentStatus])
  @@index([customerCareStaffId, customerCarePaymentStatus, sessionId], map: "attendance_cc_staff_payment_session_idx")
  @@index([customerCareStaffId, studentId, sessionId])
  @@index([assistantManagerStaffId, assistantPaymentStatus])
  @@index([assistantManagerStaffId, assistantPaymentStatus, sessionId], map: "attendance_assistant_staff_payment_session_idx")
  @@map("attendance")
}

/// Snapshot hoa hồng doanh thu của Trưởng giáo án (`lesson_plan_head`) theo từng buổi học toàn hệ thống.
/// Mỗi buổi học chargeable (tuitionFee > 0) sinh 1 dòng cho MỖI nhân sự `lesson_plan_head` active có `revenueSharePercent` tại thời điểm tạo/cập nhật buổi.
model LessonPlanHeadCommission {
  id            String        @id @default(uuid())
  attendanceId  String        @map("attendance_id")
  staffId       String        @map("staff_id")
  coefPercent   Decimal       @map("coef_percent") @db.Decimal(5, 2)
  amount        Int           @map("amount")
  paymentStatus PaymentStatus @default(pending) @map("payment_status")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  attendance    Attendance    @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  staff         StaffInfo     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([attendanceId, staffId])
  @@index([staffId, paymentStatus])
  @@map("lesson_plan_head_commission")
}

model CfProblemTutorial {
  id           String   @id @default(uuid())
  contestId    Int      @map("contest_id")
  problemIndex String   @map("problem_index")
  tutorial     String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([contestId, problemIndex])
  @@index([contestId])
  @@map("cf_problem_tutorials")
}

model Topic {
  id        String     @id @default(uuid())
  kind      TopicKind
  courseId   String?    @map("course_id")
  chapterId String?    @map("chapter_id")
  classId   String?    @map("class_id")
  title     String
  order     Int        @default(0)
  createdBy String?    @map("created_by")
  updatedBy String?    @map("updated_by")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Legacy columns kept for backward compatibility; data migrated to Lectures.
  videoUrl  String?    @map("video_url")
  content   String?

  course        Course?    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chapter       Chapter?   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  class         Class?     @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdByUser User?      @relation("TopicCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?      @relation("TopicUpdatedBy", fields: [updatedBy], references: [id])
  lectures      Lecture[]
questionLinks QuestionLink[] // back‑relation for question‑topic links

  @@index([courseId])
  @@index([chapterId])
  @@index([classId])
  @@map("topics")
}

/// Bài học — đơn vị bên trong một Chuyên đề lý thuyết, gồm video nhúng + nội dung lý thuyết.
model Lecture {
  id        String   @id @default(uuid())
  topicId   String   @map("topic_id")
  title     String
  videoUrl  String?  @map("video_url")
  content   String?
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
  @@map("lectures")
}

// Question bank models

/// Ngân hàng câu hỏi – mỗi câu thuộc một Chapter và một DifficultyLevel của course
model Question {
  id                String   @id @default(uuid())
  courseId          String   @map("course_id")
  chapterId         String   @map("chapter_id")
  difficultyLevelId String   @map("difficulty_level_id")
  type              QuestionType @default(single_choice)
  content           String   // HTML from TipTap
  options           Json?    // array of option strings (HTML or LaTeX) – only for single_choice
  correctIndex      Int?     // zero‑based index into options – required for single_choice
  explanation       String?  // optional explanation for answer (HTML)
  answerGuide       String?  // for essay type – optional guide text (HTML)
  deletedAt         DateTime? @map("deleted_at")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chapter           Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  difficultyLevel   CourseDifficultyLevel @relation(fields: [difficultyLevelId], references: [id], onDelete: Restrict)

  // future link table – defined later (ticket #55) – keep a back‑relation placeholder
  questionLinks QuestionLink[] // back‑relation for links to topics

  @@index([courseId])
  @@index([chapterId])
  @@index([difficultyLevelId])
  @@map("questions")
}

/// Chủ đề luyện tập – liên kết câu hỏi với một topic (đề, bài tập …) – minimal for delete‑warning
model QuestionLink {
  id        String @id @default(uuid())
  topicId   String @map("topic_id")
  questionId String @map("question_id")
  // order \u0026 points to be filled in later tickets
  order     Int?   @map("order")
  points    Int?   @map("points")

  topic     Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  question  Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([topicId, questionId])
  @@index([topicId])
  @@index([questionId])
  @@map("question_links")
}

enum QuestionType {
  single_choice
  essay
}
